{
  "name": "final-fantasy-xv-demo-gauntlet-opus",
  "version": "1.0.0",
  "description": "I want you to build an action role playing game at the level of the most recent Final Fantasy XV for PS4. It should be utterly perfect, visually beautiful, with every single thing done at AAA quality\u2014from textures to physics to anything you could think of.",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "shoot": "node src/tools/shoot.mts",
    "check": "node src/tools/check.mts",
    "check:perf": "node src/tools/check.mts --perf",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:tools": "tsc --noEmit -p tsconfig.tools.json",
    "build:full": "vite build && node src/tools/texbake.mts --canvas"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/three": "^0.185.4",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "typescript-api": "npm:typescript@5.9",
    "vite": "^8.2.1"
  },
  "packageManager": "pnpm@10.21.0"
}
