#!/bin/sh
#
# Refuse a commit that does not build or does not type-check.
#
# A syntax error in a module the dev server happens not to have re-parsed yet
# still boots fine in `vite dev`, then fails in `vite build` and hangs the
# capture harness on `waitForFunction`. Catching it here costs a few seconds and
# saves a confusing timeout.
#
# The build alone does not check types: vite strips them and never looks. `tsc`
# is the only thing that reads them, and a contract broken between two systems
# -- the class of bug the port exists to catch -- shows up nowhere else.
#
# It also caps the length of the documents that are always in an agent's context,
# and warns on a plan with no Status: line. Both are cheap and both run FIRST --
# see the note on ordering below.
#
# Skip with:  git commit --no-verify
# Install with: git config core.hooksPath .githooks

# ---------------------------------------------------------------------------
# Documentation gates.
#
# These MUST come before the SKIP_BUILD_CHECK early-out and before the "only if
# src/ changed" filter below, because a docs-only commit matches neither and
# would otherwise reach no check at all.
#
# The caps turn append into displace: to add a line to an always-loaded document
# you have to cull a weaker one. This exists because PROGRESS.md was allowed to
# accrete instead, reached 232 lines, and drifted five months out of date while
# still reading as current -- nobody could bring themselves to trim it because
# nothing said they were allowed to. project/README.md states the rule the caps
# enforce: a snapshot is replaced in place, never appended to, and the lossless
# history is project/journal/ and the git log.
# ---------------------------------------------------------------------------

if [ -z "$SKIP_DOCBUDGET" ] && git diff --cached --name-only | grep -q '\.md$'; then
  docfail=0
  # <path> <cap>
  while read -r doc cap; do
    [ -z "$doc" ] && continue
    git diff --cached --name-only | grep -qxF "$doc" || continue
    n=$(git show ":$doc" | wc -l | tr -d ' ')
    warn=$((cap * 85 / 100))
    if [ "$n" -gt "$cap" ]; then
      echo "pre-commit: DOC BUDGET -- $doc is $n lines, cap $cap."
      echo "            Cut something rather than appending. The history is in"
      echo "            project/journal/ and the git log, so trimming loses nothing."
      docfail=1
    elif [ "$n" -gt "$warn" ]; then
      echo "pre-commit: doc budget warning -- $doc is $n/$cap lines."
    fi
  done <<EOF
CLAUDE.md 120
BRIEF.md 150
project/STATUS.md 150
project/HANDOFF.md 250
EOF
  if [ "$docfail" = 1 ]; then
    echo
    echo "pre-commit: commit aborted. SKIP_DOCBUDGET=1 to bypass."
    exit 1
  fi

  # A plan nobody can tell the state of is a plan nobody picks up. Warn only:
  # the vocabulary is PROPOSED / LOCKED / IN-PROGRESS / DONE / PARKED /
  # SUPERSEDED, and DONE or SUPERSEDED means it belongs in project/archive/.
  for plan in $(git diff --cached --name-only --diff-filter=A | grep '^docs/plans/.*\.md$'); do
    case "$plan" in */README.md) continue ;; esac
    if ! git show ":$plan" | head -20 | grep -qE '^\*?\*?Status:'; then
      echo "pre-commit: note -- $plan has no 'Status:' line. See docs/plans/README.md."
    fi
  done
fi

if [ -n "$SKIP_BUILD_CHECK" ]; then
  echo "pre-commit: build check skipped (SKIP_BUILD_CHECK set)"
  exit 0
fi

# Only worth running when source actually changed.
if ! git diff --cached --name-only | grep -qE '^(src/|index\.html|vite\.config\.js|package\.json|tsconfig.*\.json)'; then
  exit 0
fi

# ---------------------------------------------------------------------------
# The build and both typechecks, CONCURRENTLY.
#
# They are three independent readers of the same tree -- vite strips types and
# never looks at them, and the two tsc invocations cover disjoint configs -- so
# nothing here is ordered. Run serially they were 0.64 + 0.39 + 0.40 = ~1.4 s;
# run together they are bounded by the slowest, ~0.7 s.
#
# Half a second sounds like nothing. It is not nothing here: CLAUDE.md says
# commit early and often and keep commits small, so this hook runs dozens of
# times a day per lane, and it is the one gate whose whole design rationale is
# that a gate slow enough to skip gets skipped. Making the fast lane faster is
# how it stays the fast lane.
#
# Each job's output is captured to its own file rather than interleaved: three
# compilers writing to one terminal at once produce a diagnostic nobody can
# read, and the whole value of this hook is that its failure is legible.
# ---------------------------------------------------------------------------

echo "pre-commit: build + typechecks (concurrent)..."
work=$(mktemp -d "${TMPDIR:-/tmp}/ffxv-precommit.XXXXXX")
cleanup() {
  rm -f "$work/build" "$work/game" "$work/tools"
  rmdir "$work" 2>/dev/null
}
trap cleanup EXIT

./node_modules/.bin/vite build                          >"$work/build" 2>&1 & p_build=$!
./node_modules/.bin/tsc --noEmit -p tsconfig.json       >"$work/game"  2>&1 & p_game=$!
./node_modules/.bin/tsc --noEmit -p tsconfig.tools.json >"$work/tools" 2>&1 & p_tools=$!

wait $p_build; rc_build=$?
wait $p_game;  rc_game=$?
wait $p_tools; rc_tools=$?

fail=0
if [ "$rc_build" -ne 0 ]; then
  tail -25 "$work/build"
  echo
  echo "pre-commit: BUILD FAILED — commit aborted."
  fail=1
fi
if [ "$rc_game" -ne 0 ]; then
  tail -25 "$work/game"
  echo
  echo "pre-commit: TYPECHECK FAILED (tsconfig.json) -- commit aborted."
  fail=1
fi
if [ "$rc_tools" -ne 0 ]; then
  tail -25 "$work/tools"
  echo
  echo "pre-commit: TYPECHECK FAILED (tsconfig.tools.json) -- commit aborted."
  fail=1
fi
if [ "$fail" = 1 ]; then
  echo "            fix the error, or re-run with --no-verify if you know better."
  exit 1
fi
echo "pre-commit: build ok, typecheck ok"
exit 0
