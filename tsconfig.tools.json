{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    // `DOM.Iterable` is not optional: the in-page checks spread `querySelectorAll`
    // results (`[...document.querySelectorAll('.nameplate')]`), and without it a
    // `NodeListOf<T>` has no iterator and `querySelectorAll<T>` resolves untyped.
    // Eight errors in `combatloop.mts` and `sheet.mts` were failing this config
    // on `main` and blocking the pre-commit hook for every agent.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // `vite/client` for the CSS side-effect imports the game files use, and the
    // same class-field semantics as `tsconfig.json`: the tools config reaches
    // into the game through `src/globals.d.ts`, and a file must not compile two
    // different ways depending on which config pulled it in.
    "types": ["node", "vite/client"],
    "useDefineForClassFields": false,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "useUnknownInCatchVariables": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "checkJs": false,
    // No `baseUrl`: TypeScript 7 removed it (TS5102), and `package.json` asks
    // for `^7.0.2`, so a fresh `npm install` made this config fail to load at
    // all -- which failed `npm run typecheck:tools`, and therefore the
    // pre-commit hook, on every commit in every worktree. The main checkout had
    // an older 5.9.3 lying around from a previous install, which is why it
    // looked fine here and broke for every freshly created agent. Without
    // `baseUrl`, `paths` resolves relative to this file, which is what the
    // mapping below already assumed.
    //
    // Two agents found and fixed this independently within an hour of each
    // other, which is usually a sign the failure was expensive enough to be
    // worth a comment this long.
    "paths": { "/*": ["./src/*"] }
  },
  // `src/globals.d.ts` is the same `window.GAME` / `BOOT_PROFILE` contract the
  // game declares, and the harness is the other end of it.
  "include": [
    "src/tools/**/*.mts", "src/tools/**/*.d.ts", "src/globals.d.ts",
    // Two more harness scripts, which live next to what they measure.
    "src/audio/tools/**/*.mts"
  ],
  // Probe snippets are read as text and evaluated as a *function body* inside
  // the page (`probe.mts` wraps them in `(async () => { ... })()`), so they
  // legitimately have a top-level `return` and are not modules. Nothing imports
  // them, so nothing type-strips them either.
  // `typemods/**` is the migration scaffolding: it drives the TypeScript
  // compiler API, which is `any`-heavy by nature, and it is excluded until the
  // codebase it is fixing is done. It is the one place `any` is still expected.
  "exclude": ["src/tools/_probe/**", "src/tools/probes/**", "src/tools/typemods/**"]
}
